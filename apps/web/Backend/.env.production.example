# Template only. Supply via protected service environment; never commit real values.
# Production refuses missing/weak secret, missing/wildcard hosts, DEBUG, insecure
# cookies, HTTP origins and disabled HTTPS redirect. Do NOT source the dev .env.
DJANGO_ENV=production
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=
# Empty with same-origin HTTPS frontend/API; otherwise explicit https:// origins.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CORS_ALLOW_ALL_ORIGINS=False
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=True
# True ONLY behind a trusted proxy that overwrites X-Forwarded-Proto;
# block direct public access to the WSGI upstream.
DJANGO_TRUST_PROXY=False
DJANGO_SESSION_COOKIE_AGE=28800
# Stage HSTS after HTTPS validation; no preload/subdomains until separately audited.
DJANGO_SECURE_HSTS_SECONDS=60
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
# Safe default: Django FileResponse after authorization.
# nginx requires the documented internal location, shared local storage and tests.
DJANGO_PRIVATE_MEDIA_DELIVERY=django
# Configure deployment-owned absolute paths; no example live paths assumed.
# DJANGO_MEDIA_ROOT=
# DJANGO_STATIC_ROOT=
# DB_NAME=
# Microservice URLs/timeouts: configure privately for the selected deployment.
