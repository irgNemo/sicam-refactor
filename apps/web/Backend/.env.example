# ============================================================================
# CONFIGURACIÓN DE DJANGO PARA SICAM
# ============================================================================
#
# INSTRUCCIONES:
# 1. Copiar este archivo a .env en el mismo directorio:
#    cp .env.example .env
#
# 2. Editar .env con valores reales para tu entorno
#
# 3. NUNCA commitear .env a Git (está en .gitignore)
#
# VALORES POR DEFECTO (si variable NO está definida):
# - DEBUG=True
# - ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# - DB_ENGINE=django.db.backends.sqlite3 (usa db.sqlite3 local)
# - LANGUAGE_CODE=es-mx
# - TIME_ZONE=America/Mexico_City
# - CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# - SALIVA_SEGMENTATION_SERVICE_URL=http://localhost:8001
# - BLOOD_SEGMENTATION_SERVICE_URL=http://localhost:8002
#
# ============================================================================

# ============================================================================
# SEGURIDAD (CRÍTICO EN PRODUCCIÓN)
# ============================================================================

# Clave secreta de Django. DEBE ser larga, aleatoria y única en producción.
# Generar con: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# Por defecto en desarrollo: insecure key (solo para testing)
SECRET_KEY=django-insecure-change-this-in-production

# Activar/desactivar modo debug (NUNCA True en producción)
# True = muestra stack traces en errores (inseguro)
# False = muestra página de error genérica (seguro)
DEBUG=True

# Hosts permitidos (separados por coma, sin espacios)
# En producción: solo dominios legítimos
# Ej: api.sicam.com,www.sicam.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ============================================================================
# BASE DE DATOS
# ============================================================================
#
# OPCIÓN 1: SQLITE (Desarrollo local - default)
# No definir DB_ENGINE, DB_NAME, etc. - usarán SQLite automáticamente
#
# OPCIÓN 2: POSTGRESQL (Producción recomendada)
# Descomenta y configura las siguientes líneas:

# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=sicam_db
# DB_USER=postgres
# DB_PASSWORD=cambiar-esta-contraseña
# DB_HOST=localhost
# DB_PORT=5432

# ============================================================================
# CORS - Control de origen de requests
# ============================================================================
# Dominios desde los que se permite acceso a la API (separados por coma)
# En producción: especificar solo dominios legítimos

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ============================================================================
# MICROSERVICIOS DE SEGMENTACIÓN
# ============================================================================
# URLs base de los servicios de segmentación
# En desarrollo local: localhost con puertos específicos
# En producción: URLs reales del cluster/infraestructura

# Microservicio de segmentación de muestras salivales
# Default: http://localhost:8001
SALIVA_SEGMENTATION_SERVICE_URL=http://localhost:8001

# Timeout para llamadas al servicio de saliva (segundos)
# Default: 30
SALIVA_SERVICE_TIMEOUT=30

# Microservicio de segmentación de muestras de sangre
# Default: http://localhost:8002
BLOOD_SEGMENTATION_SERVICE_URL=http://localhost:8002

# Timeout para llamadas al servicio de sangre (segundos)
# Default: 240
BLOOD_SERVICE_TIMEOUT=240

# ============================================================================
# INTERNACIONALIZACIÓN
# ============================================================================

# Código de idioma (ISO 639-1)
# Default: es-mx (Español - México)
LANGUAGE_CODE=es-mx

# Zona horaria (IANA timezone)
# Default: America/Mexico_City
TIME_ZONE=America/Mexico_City
